# CivicPulse AI - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./civicpulse.db

# Security & Admin Credentials
# Default credentials for municipal administrator review
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=civicpulse-ai-secure-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI/ML Configuration (Optional)
# If provided, real Google Gemini Vision API is used for image classification
# If left empty, CivicPulse AI uses the built-in explainable heuristic civic vision classifier
GEMINI_API_KEY=

# Initial Sample Data
# Loads realistic demo civic issues on first launch so the map and analytics are immediately viewable
SEED_DEMO_DATA=True
